{
  "components": {
    "schemas": {
      "ConfigBody": {
        "additionalProperties": false,
        "properties": {
          "acmeEnabled": {
            "type": "boolean"
          },
          "appVersion": {
            "type": "string"
          },
          "contractSha": {
            "type": "string"
          },
          "expiringSoonDays": {
            "format": "int64",
            "type": "integer"
          },
          "oidcButtonLabel": {
            "type": "string"
          },
          "oidcEnabled": {
            "type": "boolean"
          },
          "roleLevels": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "sessionIdleTimeoutSeconds": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "oidcEnabled",
          "oidcButtonLabel",
          "acmeEnabled",
          "appVersion",
          "contractSha",
          "roleLevels",
          "sessionIdleTimeoutSeconds",
          "expiringSoonDays"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "anonymous",
              "pendingMfa",
              "authenticated"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserBody"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "SessionUserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "SpikeUploadBody": {
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string"
          },
          "sizeBytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "sizeBytes"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "expiringSoon": {
            "items": {
              "$ref": "#/components/schemas/StatusExpiring"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "expiringSoon"
        ],
        "type": "object"
      },
      "StatusExpiring": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "format": "int64",
            "type": "integer"
          },
          "domain": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "domain",
          "days"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "step-ca-ui",
    "version": "1.6.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/_spike/blob": {
      "get": {
        "operationId": "getSpikeBlob",
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Placeholder binary payload.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Phase 0 spike: binary download mechanic",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/_spike/upload": {
      "post": {
        "operationId": "postSpikeUpload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "file": {
                  "contentType": "application/octet-stream"
                }
              },
              "schema": {
                "properties": {
                  "file": {
                    "contentEncoding": "binary",
                    "contentMediaType": "application/octet-stream",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpikeUploadBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Phase 0 spike: multipart upload mechanic",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get public runtime configuration",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the current session state",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get active/expiring certificate counts",
        "tags": [
          "dashboard"
        ]
      }
    }
  }
}
